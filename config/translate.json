{
  "server": "https://opencode.ai",
  "endpoint": "/inference/go/openai/v1/chat/completions",
  "model": "deepseek-v4.1-flash",
  "key_env": "OPENCODE_API_KEY",
  "target_language": "Simplified Chinese",
  "max_batch_size": 40,
  "temperature": 0.2,
  "reasoning_effort": "max",
  "instructions": [
    "译成自然、口语化、简洁的简体中文，适合做屏幕字幕，不要翻译腔。",
    "每条字幕尽量简短；保持条数与原文一一对应，不合并、不拆分、不遗漏。",
    "公司、产品与人名保留英文或通行译名，全篇统一。",
    "中文与英文、数字之间不加空格；数字按口语译法（5 million 译作“500万”）。"
  ],
  "names": [],
  "terminology": [],
  "chapter_numbering": "chapter"
}
